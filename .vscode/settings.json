{
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.suggest.insertMode": "replace",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
    },
    "[luau]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
    },
    "[lua]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
    },
    "stylua.targetReleaseVersion": "latest",
    "luau-lsp.completion.imports.requireStyle": "alwaysRelative",
    "luau-lsp.completion.imports.suggestServices": true,
    "luau-lsp.completion.imports.suggestRequires": true,
    "luau-lsp.completion.imports.enabled": true,
    "luau-lsp.platform.type": "roblox",
    "luau-lsp.ignoreGlobs": [
        "**/_Index/**",
        "**/.pesde/**",
        "luau_packages/**",
        "lune_packages/**",
        "roblox_packages/**",
        "roblox_server_packages/**",
    ],
    "luau-lsp.completion.imports.ignoreGlobs": [
        "**/_Index/**",
        "**/.pesde/**",
    ],
    "stylua.configPath": "./stylua.toml",
}